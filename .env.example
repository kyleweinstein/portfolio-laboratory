# Public Portfolio Lab service. The Webull experience is disabled unless every
# required server-side value is configured in Railway.
WEBULL_INTEGRATION_ENABLED=false
WEBULL_SERVICE_URL=http://webull-sync.railway.internal:8080
WEBULL_INTERNAL_TOKEN=
WEBULL_BENCHMARK_SYMBOL=SPY

# Owner-only GitHub sign-in for the connected-account surface.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_IDS=65232147
GITHUB_SESSION_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/webull/auth/callback
GITHUB_SESSION_TTL_SECONDS=43200
