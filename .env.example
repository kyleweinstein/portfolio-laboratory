# Public Portfolio Lab service. The Webull experience is disabled unless every
# required server-side value is configured in Railway.
WEBULL_INTEGRATION_ENABLED=false
NEXT_PUBLIC_PORTFOLIO_PUBLISHING_ENABLED=false
WEBULL_SERVICE_URL=http://webull-sync.railway.internal:8080
WEBULL_INTERNAL_TOKEN=
WEBULL_BENCHMARK_SYMBOL=SPY

# Provider-neutral aliases used by owner management, Discord session storage,
# Plaid webhooks, and follower publication. Keep these equal to the legacy
# WEBULL_* service values during migration.
PORTFOLIO_SERVICE_URL=http://webull-sync.railway.internal:8080
PORTFOLIO_INTERNAL_TOKEN=
PORTFOLIO_OWNER_GITHUB_ID=65232147

# Owner-only GitHub sign-in for the connected-account surface.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_IDS=65232147
GITHUB_SESSION_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/webull/auth/callback
GITHUB_OWNER_OAUTH_REDIRECT_URI=http://localhost:3000/api/owner/auth/callback
GITHUB_SESSION_TTL_SECONDS=43200

# Discord follower authentication. The session secret signs OAuth state; the
# resulting browser cookie contains only a random opaque session ID. Discord
# tokens and member data remain encrypted in the private broker service.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_SESSION_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/discord/auth/callback
DISCORD_SESSION_TTL_SECONDS=43200
